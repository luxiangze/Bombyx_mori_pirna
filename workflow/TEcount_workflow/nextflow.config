params {
    samplesheet = null
    outdir = "${projectDir}/../../work/tecount_workflow"
    star_index = "${projectDir}/../../reference/STARIndex"
    star_cpus = 14
    gene_gtf = "${projectDir}/../../reference/genomic_chr.gtf"
    te_gtf = "${projectDir}/../../reference/HiTE.full_length.tetranscripts.gtf"
    te_gff = null
    tecount_image = "${projectDir}/../../sifs/tetranscripts.sif"
    merge = false
}

workDir = "${projectDir}/../../work/.tecount_nextflow"
process.shell = ['/bin/bash', '-ueo', 'pipefail']

apptainer {
    enabled = true
    autoMounts = true
}

profiles {
    native {
        apptainer.enabled = false
    }
}
